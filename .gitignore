# ── Environment / IDE ────────────────────────────────────────────────────
.venv/
venv/
env/
.vscode/
.idea/
.DS_Store

# ── Caches / build ───────────────────────────────────────────────────────
**/__pycache__/
**/*.pyc
**/.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# ── Data ─────────────────────────────────────────────────────────────────
# Real full data must NOT be committed.
data/raw/*.csv
data/raw/*.parquet

# Sample data IS committed - explicit allow:
!data/sample/
!data/sample/*.csv
!data/raw/.gitkeep

# Generic ignore for processed/intermediate folders.
data/processed/

# ── Pipeline outputs ─────────────────────────────────────────────────────
# Default output root for new runs (sample / full / smoke).
artifacts/

# Legacy outputs from earlier development - large parquet matrices and
# Orange CSV exports must not be committed.
Feature Engineering/outputs/datasets/*.parquet
Feature Engineering/outputs/orange_exports/*.csv

# ── Modelling outputs (large CSVs / predictions) ─────────────────────────
Modellierung/CLS/Daten/Sample/*.csv
Modellierung/CLS/Daten/Full_scale/*.csv
Modellierung/CLS/Daten/no_groups/*.csv
Modellierung/CLS/Daten/Challenger/*.csv
Modellierung/CLS/Daten/final/final_cls_val_predictions.csv
Modellierung/REG/Daten/Sample/*.csv
Modellierung/REG/Daten/full_scale/*.csv
Modellierung/REG/Daten/minimal/*.csv
Modellierung/REG/Daten/final/final_reg_val_predictions.csv

# ── Tableau ──────────────────────────────────────────────────────────────
Tableau/*.hyper

# ── Misc ─────────────────────────────────────────────────────────────────
*.zip
*.log
*.tmp
*.bak
